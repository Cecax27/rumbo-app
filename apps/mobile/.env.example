# Copy this file to .env and fill in your Supabase project values.
# Expo inlines EXPO_PUBLIC_* variables into the app bundle at build time.

# Supabase project URL (Settings > API > Project URL)
EXPO_PUBLIC_SUPABASE_URL=

# Supabase anon (publishable) key — safe to expose in the client.
EXPO_PUBLIC_SUPABASE_ANON_KEY=
