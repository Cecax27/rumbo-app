# Copy this file to .env.local and fill in your Supabase project values.
# These are inlined into the client bundle by Next.js (NEXT_PUBLIC_ prefix).

# Supabase project URL (Settings > API > Project URL)
NEXT_PUBLIC_SUPABASE_URL=

# Supabase anon (publishable) key — safe to expose in the client.
# Use the legacy "anon" key or the newer "publishable" key (sb_publishable_...).
NEXT_PUBLIC_SUPABASE_ANON_KEY=
